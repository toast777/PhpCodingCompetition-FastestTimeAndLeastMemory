<?php

declare(strict_types=1);

memory_reset_peak_usage();
$startingMemory = memory_get_usage();
$startDatetime = date('Y-m-d H:i:s');
$startTime = microtime(true);

echo 'Start Datetime: ' . $startDatetime . PHP_EOL;
echo 'Start Time: '. $startTime . PHP_EOL;

$passwords = file('src/Password/Common/10-million-password-list-top-10000.txt', FILE_IGNORE_NEW_LINES);
$passwordCount = count($passwords);

$csSet = [];
$ciSet = [];
$onlyLower = $onlyUpper = $onlyNumbers = $onlyLetters = $onlyAlnum = $hasNonAlnum = 0;
$minLen = PHP_INT_MAX;
$maxLen = 0;
$totalLen = 0;

foreach ($passwords as $password) {
    $len = strlen($password);
    $totalLen += $len;
    if ($len < $minLen) {
        $minLen = $len;
    }
    if ($len > $maxLen) {
        $maxLen = $len;
    }

    $csSet[$password] = 1;
    $lowerPassword = strtolower($password);
    $ciSet[$lowerPassword] = ($ciSet[$lowerPassword] ?? 0) + 1;

    // Most common first: lowercase (~70%), then digits (~20%).
    if (ctype_lower($password)) {
        $onlyLower++;
        $onlyLetters++;
        $onlyAlnum++;
    } elseif (ctype_digit($password)) {
        $onlyNumbers++;
        $onlyAlnum++;
    } elseif (ctype_upper($password)) {
        $onlyUpper++;
        $onlyLetters++;
        $onlyAlnum++;
    } elseif (ctype_alpha($password)) {
        $onlyLetters++;
        $onlyAlnum++;
    } elseif (ctype_alnum($password)) {
        $onlyAlnum++;
    } else {
        $hasNonAlnum++;
    }
}

$wordData = file_get_contents('src/Password/Common/words.txt');
$wordCount = substr_count($wordData, "\n");
if ($wordData !== '' && $wordData[-1] !== "\n") {
    $wordCount++;
}

$caseSensitive = 0;
$caseInsensitive = 0;
for ($word = strtok($wordData, "\n"); $word !== false; $word = strtok("\n")) {
    if (isset($csSet[$word])) {
        $caseSensitive++;
    }
    $wordLower = strtolower($word);
    if (isset($ciSet[$wordLower])) {
        $caseInsensitive += $ciSet[$wordLower];
        unset($ciSet[$wordLower]);
    }
}

$averageLength = intdiv($totalLen * 10, $passwordCount) / 10;

echo 'Total Common Passwords: ' . $passwordCount . PHP_EOL;
echo 'Total Words: ' . $wordCount . PHP_EOL;
echo 'Common Passwords that match case-insensitive Dictionary words: ' . $caseInsensitive . PHP_EOL;
echo 'Common Passwords that match case-sensitive Dictionary words: ' . $caseSensitive . PHP_EOL;
echo 'Common Passwords that only contain lowercase letters: ' . $onlyLower . PHP_EOL;
echo 'Common Passwords that only contain uppercase letters: ' . $onlyUpper . PHP_EOL;
echo 'Common Passwords that only contain numbers: ' . $onlyNumbers . PHP_EOL;
echo 'Common Passwords that only contain letters: ' . $onlyLetters . PHP_EOL;
echo 'Common Passwords that only contain alphanumeric characters: ' . $onlyAlnum . PHP_EOL;
echo 'Common Passwords that contain any non-alphanumeric characters: ' . $hasNonAlnum . PHP_EOL;
echo 'Minimum Common Password Length: ' . $minLen . PHP_EOL;
echo 'Maximum Common Password Length: ' . $maxLen . PHP_EOL;
echo 'Average Common Password Length: ' . $averageLength . PHP_EOL;

$endDatetime = date('Y-m-d H:i:s');
echo 'End Datetime: ' . $endDatetime . PHP_EOL;
$endTime = microtime(true);
echo 'End Time: ' . $endTime . PHP_EOL;
echo 'Total Time: ' . ($endTime - $startTime) . PHP_EOL;
$totalMemoryUsed = memory_get_peak_usage() - $startingMemory;
echo 'Peak Memory: ' . memory_get_peak_usage() . PHP_EOL;
echo 'Memory Used: ' . $totalMemoryUsed . PHP_EOL;
